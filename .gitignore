# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist
/dist-electron
/release

# eleventy (landing build output)
/_site

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local settings
.claude/settings.local.json

# playwright-mcp
.playwright-mcp

.claude/scheduled_tasks.lock

# Runtime log directory the server logger creates; test runs produce it too,
# so without this a clean checkout is dirty the moment `pnpm test` is run.
.purplemux/

# internal records kept out of the public repo (vel-PMX-PUBLIC)
docs-local/
